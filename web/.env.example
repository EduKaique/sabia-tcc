# URLs base da API, embutidas no build (NEXT_PUBLIC_*). Copie para .env.local no dev.
#
# Dev: o browser fala direto com o api-gateway (porta 8000).
# Prod (atrás do proxy, mesma origem): NEXT_PUBLIC_API_URL vazio (chamadas relativas
# /api/auth, /api/publico, /api/ia) e NEXT_PUBLIC_PEDAGOGICO_API_URL=/api/pedagogico.
# São os defaults dos build args do Dockerfile (estágio build).
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PEDAGOGICO_API_URL=http://localhost:8000/api/pedagogico
