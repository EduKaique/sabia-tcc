# Banco de dados (Auth DB — isolado do monólito)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5434/sabia_auth
SPRING_DATASOURCE_USERNAME=sabia
SPRING_DATASOURCE_PASSWORD=sabia

# Perfil ativo (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Porta HTTP
SERVER_PORT=8081

# JWT — MESMO segredo em todos os serviços e no API Gateway.
# O auth-service é o único emissor; os demais apenas validam.
JWT_SECRET=dev-secret-change-in-production-must-be-at-least-32-chars
JWT_EXPIRATION_MS=28800000

# CORS (origens do frontend)
CORS_ORIGINS=http://localhost:3000

# Recuperação de senha
FRONTEND_RECUPERAR_SENHA_URL=http://localhost:3000/redefinir-senha
# Provedor de e-mail: "dev" apenas loga o link no console; "smtp" envia de verdade
EMAIL_PROVIDER=dev
EMAIL_FROM=no-reply@sabia.edu
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
