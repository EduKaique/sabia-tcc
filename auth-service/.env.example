# Banco de dados compartilhado (schema exclusivo do auth-service)
# Também aceita DB_URL / DB_USER / DB_PASS.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/sabia?currentSchema=auth
SPRING_DATASOURCE_USERNAME=sabia
SPRING_DATASOURCE_PASSWORD=sabia

# Perfil ativo (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# Porta HTTP
SERVER_PORT=8080

# JWT — MESMO segredo em todos os serviços e no API Gateway.
# O auth-service é o único emissor; os demais apenas validam.
# Valor abaixo é o default de dev: o profile prod NÃO sobe com ele
# (exige mín. 32 bytes e não-default). Gere com: openssl rand -base64 48
JWT_SECRET=dev-secret-change-in-production-must-be-at-least-32-chars
JWT_EXPIRATION_MS=28800000

# CORS (origens do frontend)
CORS_ORIGINS=http://localhost:3000

# Serviço Pedagógico (primeiro acesso do aluno por código)
PEDAGOGICO_URL=http://localhost:8081

# Recuperação de senha
FRONTEND_RECUPERAR_SENHA_URL=http://localhost:3000/redefinir-senha
# Provedor de e-mail: "dev" apenas loga o link no console; "smtp" envia de verdade
EMAIL_PROVIDER=dev
EMAIL_FROM=no-reply@sabia.edu
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- Somente profile prod ----
# update (padrão) cria o schema e as tabelas na primeira subida; validate/none não criam nada
# JPA_DDL_AUTO=update
# Usuários iniciais (criados só se o e-mail não existir). Sem *_EMAIL não cria;
# sem *_SENHA usa a senha padrão "senha123" — defina! *_CPF é opcional.
# SABIA_ADMIN_EMAIL=
# SABIA_ADMIN_SENHA=
# SABIA_ADMIN_NOME=Administrador
# SABIA_ADMIN_CPF=
# SABIA_PROFESSOR_EMAIL=
# SABIA_PROFESSOR_SENHA=
# SABIA_PROFESSOR_NOME=Professor
# SABIA_PROFESSOR_CPF=
