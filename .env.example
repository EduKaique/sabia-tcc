# Chave da API do Gemini
GEMINI_API_KEY=api_key_aqui
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45

# JWT compartilhado entre auth-service, pedagogico-service e API Gateway (MESMO valor).
# Vazio -> o docker-compose usa o default de dev. Em produção é obrigatório,
# com no mínimo 32 bytes e diferente dos defaults do repositório.
# Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=28800000

# CORS (origens do frontend, separadas por vírgula) — gateway, auth e pedagógico
CORS_ORIGINS=http://localhost:3000

# API Gateway
GATEWAY_PORT=8000
JWT_EXPIRES_IN=1h
AUTH_URL=http://auth-service:8080
PEDAGOGICO_URL=http://pedagogico-service:8081
IA_URL=http://ia-service:8002

# Frontend (o browser fala com o gateway)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_PEDAGOGICO_API_URL=http://localhost:8000/api/pedagogico


# Recuperação de senha (auth-service)
# EMAIL_PROVIDER=dev  -> apenas loga o link no console (padrão, sem envio real)
# EMAIL_PROVIDER=smtp -> envia e-mail de verdade usando as credenciais abaixo
EMAIL_PROVIDER=dev
EMAIL_FROM=no-reply@sabia.edu
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=


# ------------------------------------------------------------------
# Produção (SPRING_PROFILES_ACTIVE=prod / NODE_ENV=production)
# Sem JWT_SECRET, senha do banco ou senha do RabbitMQ os serviços não sobem.
# ------------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=prod
# NODE_ENV=production

# Banco: os serviços aceitam SPRING_DATASOURCE_* ou DB_URL/DB_USER/DB_PASS
# SPRING_DATASOURCE_USERNAME=sabia
# SPRING_DATASOURCE_PASSWORD=
# RABBITMQ_USER=sabia
# RABBITMQ_PASS=

# update (padrão) cria o schema e as tabelas na primeira subida; validate/none não criam nada
# JPA_DDL_AUTO=update

# Usuários iniciais criados pelo auth-service no profile prod (só se o e-mail não existir).
# Sem *_EMAIL o usuário não é criado. Sem *_SENHA é usada a senha padrão "senha123" — defina!
# *_CPF é opcional (placeholders 00000000000 / 00000000001).
# SABIA_ADMIN_EMAIL=
# SABIA_ADMIN_SENHA=
# SABIA_ADMIN_NOME=Administrador
# SABIA_ADMIN_CPF=
# SABIA_PROFESSOR_EMAIL=
# SABIA_PROFESSOR_SENHA=
# SABIA_PROFESSOR_NOME=Professor
# SABIA_PROFESSOR_CPF=
