# Chave da API do Gemini
GEMINI_API_KEY=api_key_aqui

# JWT compartilhado entre os serviços
JWT_SECRET=dev-secret-change-in-production-must-be-at-least-32-chars
JWT_EXPIRATION_MS=28800000

# API Gateway
GATEWAY_PORT=3000
JWT_EXPIRES_IN=1h
AUTH_URL=http://localhost:8081
PEDAGOGICO_URL=http://localhost:8082

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3000


# Recuperação de senha (auth-service)
# EMAIL_PROVIDER=dev  -> apenas loga o link no console (padrão, sem envio real)
# EMAIL_PROVIDER=smtp -> envia e-mail de verdade usando as credenciais abaixo
EMAIL_PROVIDER=dev
EMAIL_FROM=no-reply@sabia.edu
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
