# ===================================================================
# .env.prod — variáveis do docker-compose.prod.yml
#
#   cp deploy/.env.prod.example .env.prod   # na RAIZ do repositório
#   chmod 600 .env.prod                     # deploy.sh recusa outro modo
#
# NUNCA commite o .env.prod (está no .gitignore) nem cole seus valores em chats/issues.
# Gerar segredos:
#   openssl rand -base64 48                              # JWT_SECRET
#   openssl rand -base64 24 | tr -d '/+=' | cut -c1-24   # senhas (20+ caracteres)
# ===================================================================

# --- Imagens -------------------------------------------------------
# IMAGE_TAG é passada pelo deploy.sh (ex.: deploy/deploy.sh sha-1a2b3c4); não defina aqui.
# Registry com o owner do GitHub em minúsculas.
REGISTRY=ghcr.io/edukaique

# --- Endereço e HTTPS ----------------------------------------------
# IP público do servidor (sem http://).
SITE_ADDRESS=
# Primeiro deploy: use o STAGING (certificado não confiável, mas sem limite de emissão).
# Depois que funcionar, troque pela produção e rode o deploy de novo.
#   staging:  https://acme-staging-v02.api.letsencrypt.org/directory
#   produção: https://acme-v02.api.letsencrypt.org/directory
ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory
# Caddyfile (HTTPS por IP) ou Caddyfile.http (só HTTP: smoke test/contingência).
CADDYFILE=Caddyfile

# Origem do front, igual ao que o navegador mostra: https://<IP>.
# Durante o smoke em HTTP, use "https://<IP>,http://<IP>".
CORS_ORIGINS=

# --- Banco ---------------------------------------------------------
# Senha do usuário "sabia" do Postgres (20+ caracteres). Usada pelo banco e pelos
# serviços Java. Trocar depois da 1ª subida NÃO altera a senha do volume existente.
POSTGRES_PASSWORD=

# --- JWT -----------------------------------------------------------
# Mesmo valor em auth, pedagógico e gateway (o compose cuida disso).
# Mínimo 32 bytes e diferente dos defaults do repositório, senão os serviços não sobem.
JWT_SECRET=
# JWT_EXPIRATION_MS=28800000

# --- Usuários iniciais (criados só se o e-mail ainda não existir) ---
# Senhas com NO MÍNIMO 12 caracteres (regra do deploy; o sistema não valida).
# Troque-as pelo próprio sistema depois do primeiro acesso.
SABIA_ADMIN_EMAIL=
SABIA_ADMIN_SENHA=
# SABIA_ADMIN_NOME=Administrador
# SABIA_ADMIN_CPF=
SABIA_PROFESSOR_EMAIL=
SABIA_PROFESSOR_SENHA=
SABIA_PROFESSOR_NOME=
# SABIA_PROFESSOR_CPF=

# --- Recuperação de senha / e-mail ---------------------------------
# Tela de redefinição do front.
FRONTEND_RECUPERAR_SENHA_URL=https://<IP>/redefinir-senha
# dev: NÃO envia e-mail, só escreve o link (com token) no log do auth-service.
# smtp: envia de verdade com as credenciais abaixo.
EMAIL_PROVIDER=smtp
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- IA (Gemini) ---------------------------------------------------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_SECONDS=45

# --- Memória -------------------------------------------------------
# Os padrões do compose são para 4 GB. Para ~1,6 GB veja deploy/env.lowmem.example.
# MEM_CADDY=64m
# MEM_WEB=384m
# MEM_GATEWAY=160m
# MEM_AUTH=640m
# MEM_PEDAGOGICO=640m
# MEM_IA=192m
# MEM_DATABASE=384m
# JAVA_OPTS=-XX:MaxRAMPercentage=60 -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Xss512k

# --- Backup (usado por deploy/backup.sh) ---------------------------
# BACKUP_DIR=/var/backups/sabia
# Cópia externa opcional (rsync/scp), ex.: usuario@outro-host:/backups/sabia/
# BACKUP_REMOTE=
