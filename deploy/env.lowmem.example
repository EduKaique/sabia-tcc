# EMERGÊNCIA — VM com ~1,6 GB de RAM. NÃO recomendado: o alvo é 4 GB.
# Copie estas linhas para o FIM do .env.prod (sobrescrevem os padrões do compose).
# Soma dos limites: ~1440m. Os serviços Java ficam no limite: espere startup lento
# e risco de OOM com muitos alunos simultâneos. Ative swap (1–2 GB) no servidor.
MEM_CADDY=48m
MEM_WEB=192m
MEM_GATEWAY=112m
MEM_AUTH=384m
MEM_PEDAGOGICO=384m
MEM_IA=128m
MEM_DATABASE=192m
JAVA_OPTS=-XX:MaxRAMPercentage=60 -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Xss512k -XX:MaxMetaspaceSize=128m -XX:ReservedCodeCacheSize=32m
